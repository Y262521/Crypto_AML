
# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=aml_raw
MONGO_FLAT_TX_DB=aml_raw
MONGO_FLAT_TX_COLLECTION=raw_transactions
MONGO_RAW_DB=aml_raw
MONGO_RAW_COLLECTION=raw_blocks
MONGO_PROCESSED_DB=aml_raw
MONGO_PROCESSED_COLLECTION=processed_transactions

# Ethereum RPC
ALCHEMY_RPC=https://eth-mainnet.g.alchemy.com/v2/rGGUSUFNHfTrp5nrkZdH9
ETH_NETWORK=ethereum-mainnet
ETH_START_BLOCK=21000000
ETH_BATCH_SIZE=50

# Multi-chain EVM RPC (Phase 2)
# Derive from the same Alchemy key — just change the network slug
# Leave blank to skip that chain during ETL
ALCHEMY_API_KEY=rGGUSUFNHfTrp5nrkZdH9
BNB_RPC=https://bnb-mainnet.g.alchemy.com/v2/qpdhZ5M4OnDRtKGCNSobh
BNB_START_BLOCK=44000000
POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/L_UtIkrVQ-lRp9Jtf4yRv
POLYGON_START_BLOCK=65000000
ARBITRUM_RPC=https://arb-mainnet.g.alchemy.com/v2/ikxQL0u22F5jApp_h44kC
ARBITRUM_START_BLOCK=280000000
BASE_RPC=https://base-mainnet.g.alchemy.com/v2/oQIFqAJhHBJtzMSDUkel0
BASE_START_BLOCK=25000000

# UTXO chain RPC (Phase 3) — Alchemy UTXO API
BITCOIN_RPC=https://bitcoin-mainnet.g.alchemy.com/v2/k5a0S3fxHr5TMxi8T5Bsk
BITCOIN_START_BLOCK=840000
LITECOIN_RPC=https://litecoin-mainnet.g.alchemy.com/v2/k5a0S3fxHr5TMxi8T5Bsk
LITECOIN_START_BLOCK=2600000
DOGECOIN_RPC=https://dogecoin-mainnet.g.alchemy.com/v2/k5a0S3fxHr5TMxi8T5Bsk
DOGECOIN_START_BLOCK=5000000
BITCOINCASH_RPC=https://bitcoincash-mainnet.g.alchemy.com/v2/k5a0S3fxHr5TMxi8T5B
sk
BITCOINCASH_START_BLOCK=850000

# Solana RPC (Phase 4)
SOLANA_RPC=https://solana-mainnet.g.alchemy.com/v2/k5a0S3fxHr5TMxi8T5Bsk
# Leave blank to auto-use recent slots (recommended)
# Or set to a recent confirmed slot number
SOLANA_START_SLOT=

# ETL / transform
BATCH_SIZE_TRANSFORM=100
AML_HIGH_VALUE_THRESHOLD=10.0
STAGING_FOLDER=data/staging
PROCESSED_FOLDER=data/processed

# Databases
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=yona@1221
NEO4J_DATABASE=neo4j
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=aml_clean

# Loader / clustering
BATCH_SIZE=1000
NEO4J_BATCH_SIZE=500
LOG_LEVEL=INFO
DBSCAN_EPS=0.6
DBSCAN_MIN_SAMPLES=5
VELOCITY_24H_THRESHOLD=6

# Pipeline schedule: comma-separated hours in UTC (24h format)
# "8,20" = run at 08:00 UTC and 20:00 UTC every day (2 runs/day)
PIPELINE_SCHEDULE_HOURS=8,20